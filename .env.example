# --- Redes ---
AMOY_RPC_URL=
POLYGON_RPC_URL=

# --- Preventa: lo que usa script/DeployPresale.s.sol ---
# El token HACK se despliega aparte; aquí va su dirección ya desplegada en la red destino.
HACK_TOKEN_ADDRESS=
# Multifirma que administra la preventa. Recibe los tres roles en el constructor.
PRESALE_ADMIN_ADDRESS=
# Cupo de la preventa pública, en unidades de 18 decimales.
# Whitepaper: 100,000,000 HACK (10% del supply máximo).
PRESALE_CAP=100000000000000000000000000

# --- Resto del stack: lo que usa script/DeployCore.s.sol ---
# No se usa para desplegar la preventa.
TREASURY_ADDRESS=
PROTOCOL_ADMIN_ADDRESS=
# Whitepaper: 300,000,000 HACK (30% del supply máximo) para IncentivesPool.
INITIAL_REWARD_POOL_FUNDING=300000000000000000000000000
